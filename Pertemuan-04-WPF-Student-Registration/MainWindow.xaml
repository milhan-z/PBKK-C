<Window x:Class="Pertemuan_04_WPF_Student_Registration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formulir Registrasi Mahasiswa - PBKK C" 
        Height="820" Width="940" 
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        FontSize="13">
    
    <Window.Resources>
        <!-- Modern Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="18,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Formulir Pendaftaran Mahasiswa Baru" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Pemrograman Berbasis Kerangka Kerja (PBKK C) - Institut Teknologi Sepuluh Nopember" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Pertemuan 04 - WPF Rich UI" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area: 2 Columns (Form & Preview) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Input Form -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18,16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Data Identitas Calon Mahasiswa" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                    <!-- NRP -->
                    <TextBlock Text="NRP (Nomor Registrasi Pokok) *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtNrp" Margin="0,0,0,8"/>

                    <!-- Nama Lengkap -->
                    <TextBlock Text="Nama Lengkap *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtNama" Margin="0,0,0,8"/>

                    <!-- Email -->
                    <TextBlock Text="Alamat Email *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtEmail" Margin="0,0,0,8"/>

                    <!-- Jenis Kelamin -->
                    <TextBlock Text="Jenis Kelamin *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="rbLaki" Content="Laki-laki" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbPerempuan" Content="Perempuan" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Program Studi -->
                    <TextBlock Text="Program Studi Pilihan *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbProdi" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,8">
                        <ComboBoxItem Content="S1 Teknik Informatika" IsSelected="True"/>
                        <ComboBoxItem Content="S1 Sistem Informasi"/>
                        <ComboBoxItem Content="S1 Teknologi Informasi"/>
                        <ComboBoxItem Content="S1 Sains Data"/>
                        <ComboBoxItem Content="S1 Rekayasa Perangkat Lunak"/>
                        <ComboBoxItem Content="S1 Teknik Komputer"/>
                    </ComboBox>

                    <!-- Jalur Masuk & Tanggal Lahir (2 Columns) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Jalur Masuk *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                            <ComboBox x:Name="cmbJalur" Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="SNBP (Prestasi)" IsSelected="True"/>
                                <ComboBoxItem Content="SNBT (Tes Mandiri)"/>
                                <ComboBoxItem Content="Seleksi Prestasi Mandiri"/>
                                <ComboBoxItem Content="Kemitraan &amp; Kerjasama"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tanggal Lahir *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                            <DatePicker x:Name="dpTanggalLahir" Height="30" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bidang Minat / Peminatan -->
                    <TextBlock Text="Bidang Peminatan / Minat Teknis" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="chkWeb" Content="Web Development" IsChecked="True" Margin="0,0,14,4"/>
                        <CheckBox x:Name="chkMobile" Content="Mobile App" Margin="0,0,14,4"/>
                        <CheckBox x:Name="chkAI" Content="AI &amp; Data Science" IsChecked="True" Margin="0,0,14,4"/>
                        <CheckBox x:Name="chkCyber" Content="Cyber Security" Margin="0,0,14,4"/>
                    </WrapPanel>

                    <!-- Alamat -->
                    <TextBlock Text="Alamat Domisili *" FontWeight="Medium" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtAlamat" Height="46" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnReset" Content="Reset Formulir" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="btnReset_Click"/>
                        <Button x:Name="btnSimpan" Content="Daftar Sekarang" Style="{StaticResource PrimaryButton}" Click="btnSimpan_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Column 2: Live Summary Card -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Summary Header -->
                    <TextBlock Grid.Row="0" Text="Pratinjau Data Terdaftar" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                    <!-- Status Badge -->
                    <Border x:Name="badgeStatus" Grid.Row="1" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,14">
                        <TextBlock x:Name="txtStatus" Text="● Status: Belum Didaftarkan" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626"/>
                    </Border>

                    <!-- Preview Content -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="NRP:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewNrp" Text="-" FontWeight="Bold" Foreground="#0F172A" FontSize="13" Margin="0,1,0,8"/>

                                <TextBlock Text="Nama Lengkap:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewNama" Text="-" FontWeight="Bold" Foreground="#0F172A" FontSize="13" Margin="0,1,0,8"/>

                                <TextBlock Text="Email:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewEmail" Text="-" Foreground="#0F172A" Margin="0,1,0,8"/>

                                <TextBlock Text="Jenis Kelamin:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewJK" Text="-" Foreground="#0F172A" Margin="0,1,0,8"/>

                                <TextBlock Text="Program Studi:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewProdi" Text="-" Foreground="#0F172A" Margin="0,1,0,8"/>

                                <TextBlock Text="Jalur Masuk:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewJalur" Text="-" Foreground="#0F172A" Margin="0,1,0,8"/>

                                <TextBlock Text="Tanggal Lahir:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewTglLahir" Text="-" Foreground="#0F172A" Margin="0,1,0,8"/>

                                <TextBlock Text="Minat / Keahlian:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewMinat" Text="-" Foreground="#0F172A" Margin="0,1,0,8"/>

                                <TextBlock Text="Alamat Domisili:" FontWeight="SemiBold" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="lblPreviewAlamat" Text="-" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,1,0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Info -->
                    <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="4" Padding="8" Margin="0,12,0,0">
                        <TextBlock x:Name="lblWaktuRegistrasi" Text="Waktu Pendaftaran: -" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
